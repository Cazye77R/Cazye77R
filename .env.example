# Elephant configuration — copy to .env and adjust as needed

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
EMBEDDING_MODEL=nomic-embed-text

# Paths (relative to the project root or absolute)
# MEMORY_PATH=/path/to/memories
# CHROMA_PATH=/path/to/chroma

# RAG settings
TOP_K=5
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# Memory decay (importance reduction per day, applied to unaccessed memories)
DECAY_RATE=0.01

# Consolidation threshold (cosine similarity above which memories are candidates)
CONSOLIDATION_THRESHOLD=0.8
