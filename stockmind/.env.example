# StockMind – Umgebungsvariablen
# Kopiere diese Datei als .env und passe die Werte an.
# .env wird NICHT ins Repository eingecheckt; .env.example schon.

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL des laufenden Ollama-Servers (lokal oder Remote)
# OLLAMA_HOST=http://localhost:11434

# ── Cache ─────────────────────────────────────────────────────────────────────
# Lebensdauer des OHLCV-Daten-Caches in Stunden (0 = kein Cache)
# CACHE_TTL_HOURS=24

# ── Logging ───────────────────────────────────────────────────────────────────
# Log-Level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# ── UCB1 Exploration vs. Exploitation ─────────────────────────────────────────
# Exploration-Konstante für den Auto-Training-Algorithmus
# Höher = mehr Exploration neuer Methoden, niedriger = mehr Exploitation bekannter Methoden
# Standard: 1.414 = sqrt(2) (theoretischer Optimalwert für UCB1)
# EXPLORATION_CONSTANT=1.414

# ── Easter Eggs ───────────────────────────────────────────────────────────────
# Easter Eggs aktivieren (Lambo-Währung, Konfetti, versteckte Überraschungen)
# ENABLE_EASTER_EGGS=true

# ── LLM Provider ──────────────────────────────────────────────────────────────
# "ollama" (lokal, Standard) | "nvidia" (Cloud, NIM-API)
# LLM_PROVIDER=ollama

# ── NVIDIA NIM (nur wenn LLM_PROVIDER=nvidia) ─────────────────────────────────
# API-Key von https://build.nvidia.com/
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
