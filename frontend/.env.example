# ── StockMind Frontend Environment Variables ─────────────────────────────────
# Copy this file to .env.local and fill in values for local development.

# Base URL of the StockMind FastAPI backend (future wiring)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Optional overrides ────────────────────────────────────────────────────────
# Uncomment to enable verbose debug logging in the browser console
# NEXT_PUBLIC_DEBUG=true
